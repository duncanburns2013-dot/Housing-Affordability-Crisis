# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# node
node_modules/
npm-debug.log*

# local data caches that can be regenerated
data/raw/*.zip
data/raw/*.xlsx
data/raw/.cache/

# logs
*.log

# secrets — NEVER commit
.env
.env.*
!.env.example
*.token
*.secret
data/raw/mlspin_*.json
data/raw/bridge_*.json
data/raw/ma-towns-raw.geojson

# Large CTHRU checkbook exports — processed JSON ships, raw CSVs don't
data/raw/cthru_checkbook/checkbook_data_*.csv

# Keep compressed -web.jpg in repo, originals stay local.
# Match only the original-filename suffixes; wildcards in earlier
# revisions caught the -web.jpg variants as collateral.
assets/*-utc.jpg
assets/*-utc.jpeg
assets/EA Shelter.PNG
assets/Uhaul.jpg
assets/healey-source.*

# Personal/promotional assets — not part of the dashboard repo
assets/share-collage.png
pipelines/build_collage.js
