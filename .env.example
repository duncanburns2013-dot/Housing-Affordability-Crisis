# Copy this file to `.env` and fill in your real token. .env is gitignored.
# Find your token at: https://bridgedataoutput.com/  →  Apps / API Keys
BRIDGE_TOKEN=your_server_access_token_here

# Dataset slug. For Massachusetts MLS PIN, this is typically "mlspin".
# Confirm by logging in and looking at the dataset name in the UI.
BRIDGE_DATASET=mlspin
